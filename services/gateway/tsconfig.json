{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2021",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
