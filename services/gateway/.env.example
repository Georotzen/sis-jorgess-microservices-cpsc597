# Copy to .env and fill in real values (pulled from Vault at deploy time).
PORT=3000

# Keycloak — used ONLY for OAuth2 token introspection (RFC 7662), never
# for creating/modifying users. That's the Identity service's job.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=sis
KEYCLOAK_INTROSPECTION_CLIENT_ID=sis-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET=changeme

# Rate limiting (per architecture notes: gateway applies rate limiting)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
