# Copy to .env and fill in real values (pulled from Vault at deploy time).
PORT=3000

# Local database (database-per-service). Individual vars, not a single
# DATABASE_URL — matches what infra/docker/docker-compose.yml's
# `audit` service already sets via `environment:`.
DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_USER=audit_svc
DATABASE_PASSWORD=changeme
DATABASE_NAME=audit

# Keycloak — used for local JWT signature verification only (JWKS),
# same pattern as every other service.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=sis

# RabbitMQ — this service is the consumer for every publisher's
# AuditPublisherService (identity, grades, enrollment).
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_AUDIT_EXCHANGE=sis.audit
RABBITMQ_AUDIT_QUEUE=audit.events
