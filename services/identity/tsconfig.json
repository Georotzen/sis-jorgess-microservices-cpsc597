{
  "compilerOptions": {
    "types": ["jest", "node"],
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "ignoreDeprecations": "5.0",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts","src/**/*.ts","**/*.tsx"],
  "exclude": ["node_modules"]
}
