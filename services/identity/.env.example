# Copy to .env and fill in real values (pulled from Vault at deploy time).
PORT=3001

# Local database (database-per-service)
DATABASE_URL=postgresql://identity_svc:changeme@localhost:5432/identity

# Keycloak
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=sis

# Client used for OAuth2 introspection is the Gateway's concern, not Identity's.

# Client used by Identity to manage users (create/assign roles) via Admin API.
# Scoped to realm-management: manage-users, view-users, query-users ONLY.
KEYCLOAK_ADMIN_CLIENT_ID=sis-identity-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme

# Client used by Identity to exchange email/password for tokens (ROPC grant).
# Never exposed to the browser — this call happens server-to-server only.
KEYCLOAK_PASSWORD_GRANT_CLIENT_ID=sis-identity-password-grant
KEYCLOAK_PASSWORD_GRANT_CLIENT_SECRET=changeme

# RabbitMQ (publishes AuditEventDto messages)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_AUDIT_EXCHANGE=sis.audit
