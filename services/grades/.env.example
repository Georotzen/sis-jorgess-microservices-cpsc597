# Copy to .env and fill in real values (pulled from Vault at deploy time).
PORT=3000

# Local database (database-per-service). Individual vars, not a single
# DATABASE_URL — matches what infra/docker/docker-compose.yml's
# `grades` service already sets via `environment:`.
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USER=grades_svc
DATABASE_PASSWORD=changeme
DATABASE_NAME=grades

# Keycloak — used for local JWT signature verification only (JWKS),
# same as every other service's copy of this pattern.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=sis

# Enrollment service, called to verify instructor-of-record status
# before accepting a grade entry (see instructor-verification.service.ts).
ENROLLMENT_SERVICE_URL=http://enrollment:3000
