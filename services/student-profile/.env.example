# Copy to .env and fill in real values (pulled from Vault at deploy time).
PORT=3000

# Local database (database-per-service). Individual vars, not a single
# DATABASE_URL — matches what infra/docker/docker-compose.yml's
# `student-profile` service already sets via `environment:`.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=student_profile_svc
DATABASE_PASSWORD=changeme
DATABASE_NAME=student_profile

# Keycloak — used for local JWT signature verification only (JWKS),
# same as Identity's copy of this pattern. Never used to mint tokens
# from this service.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=sis

# AES-256 key for field-level encryption of SENSITIVE columns
# (legalFirstName, legalLastName, dateOfBirth, phoneNumber, homeAddress).
# Must decode (base64) to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Rotating this key requires re-encrypting existing rows — there is no
# key-rotation support yet.
STUDENT_PROFILE_FIELD_ENCRYPTION_KEY=changeme
