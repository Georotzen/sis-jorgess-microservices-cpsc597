      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "KcCli_e63a53c9d506cf2ffd1abbad8763482bea5b7a93f012dc76",
      "attributes": {
        "token.endpoint.auth.signing.alg": "RS256"
      }
    },
    {
      "clientId": "sis-identity-admin",
      "description": "Confidential client with a service account scoped ONLY to manage-users. Used by the Identity service to create users / assign roles via the Keycloak Admin REST API. Never grant this client realm-admin.",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "sis-identity-admin-secret"
    },
    {
      "clientId": "sis-identity-password-grant",
