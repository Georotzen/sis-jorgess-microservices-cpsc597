NODE_ENV=development
PORT=3001
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=sis
KEYCLOAK_ADMIN_CLIENT_ID=sis-identity-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=sis-identity-admin-secret
KEYCLOAK_PASSWORD_GRANT_CLIENT_ID=sis-identity-password-grant
KEYCLOAK_PASSWORD_GRANT_CLIENT_SECRET=sis-identity-password-grant-secret
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_AUDIT_EXCHANGE=sis.audit
